---
import Layout from '../layouts/Layout.astro';

const email = 'contact@infinitaCM.com';
---

<Layout
  title="Contact — Infinita Holdings LLC"
  description="Direct enquiries to Infinita Holdings LLC. Correspondence is handled with discretion."
>
  <section class="page-hero section--dark">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Correspondence.</h1>
      <p class="lede">
        Infinita does not solicit. Considered enquiries are reviewed and
        answered with discretion.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <div class="contact__col">
        <p class="eyebrow">Direct</p>
        <p class="contact__email">
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>
      <div class="contact__col">
        <p class="eyebrow">Note</p>
        <p class="contact__note">
          Infinita is a privately held capital platform. It is not a fund nor a
          financial product company, and does not accept outside capital or
          provide investment advice. All correspondence is treated in confidence.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-block: clamp(4.5rem, 11vw, 8rem); }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: start;
  }
  .contact__email {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    margin: 0;
  }
  .contact__email a { color: var(--ink); border-bottom: 1px solid var(--gold); }
  .contact__email a:hover { color: var(--gold-dark); }
  .contact__note { color: var(--muted); margin: 0; max-width: 46ch; }

  @media (max-width: 820px) {
    .contact { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
