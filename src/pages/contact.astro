---
import Layout from '../layouts/Layout.astro';

// NOTE: Replace email/location with Infinita's real details.
const email = 'hello@infinita.one';
---

<Layout
  title="Contact — Infinita"
  description="Get in touch with Infinita to start a confidential conversation."
>
  <section class="page-hero section--dark">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Start a conversation.</h1>
      <p class="lede">
        We work with a select group of families. Reach out and we’ll respond
        personally and in confidence.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <div class="contact__details">
        <p class="eyebrow">Direct</p>
        <p>
          <a href={`mailto:${email}`}>{email}</a>
        </p>
        <p class="contact__note">
          All enquiries are treated with the strictest confidence.
        </p>
      </div>

      <form
        class="contact__form"
        name="contact"
        method="POST"
        action="#"
      >
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="message">How can we help?</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn">Send message</button>
        <p class="contact__formnote">
          <em>[Form is not yet wired to a backend — see notes.]</em>
        </p>
      </form>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-block: clamp(4.5rem, 11vw, 8rem); }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3.5rem;
    align-items: start;
  }
  .contact__details p { font-size: 1.15rem; }
  .contact__details a { font-family: var(--font-serif); font-size: 1.4rem; }
  .contact__note { color: var(--muted); font-size: 0.95rem !important; }

  .field { margin-bottom: 1.5rem; display: flex; flex-direction: column; }
  .field label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }
  .field input,
  .field textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    background: var(--paper-pure);
    color: var(--ink);
    border-radius: 0;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--bronze);
    outline: none;
  }
  .field textarea { resize: vertical; }
  .contact__formnote { color: var(--muted); font-size: 0.85rem; margin-top: 1rem; }

  @media (max-width: 820px) {
    .contact { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
