---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — E3J"
  description="E3J does not solicit. Correspondence is handled via Infinita."
>
  <section class="page-hero section--dark">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Correspondence.</h1>
      <p class="lede">
        E3J does not solicit. Considered enquiries are reviewed and answered
        with discretion.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <div class="contact__col">
        <p class="eyebrow">Via Infinita</p>
        <p class="contact__link">
          <a href="https://infinita.one/contact" rel="noopener">infinita.one/contact</a>
        </p>
      </div>
      <div class="contact__col">
        <p class="eyebrow">Note</p>
        <p class="contact__note">
          E3J is a private holding entity. It offers no products or services,
          does not accept outside capital, and does not provide investment
          advice. All correspondence is treated in confidence.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-block: clamp(4.5rem, 11vw, 8rem); }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: start;
  }
  .contact__link {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    margin: 0;
  }
  .contact__link a { color: var(--paper); border-bottom: 1px solid var(--gold); }
  .contact__link a:hover { color: var(--gold); }
  .contact__note { color: var(--muted); margin: 0; max-width: 46ch; }

  @media (max-width: 820px) {
    .contact { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
