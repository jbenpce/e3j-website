---
import Layout from '../layouts/Layout.astro';

// Base-aware asset paths so images resolve at the root (infinita.one) and under
// the GitHub Pages sub-path (/Infinita-website/).
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const asset = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

// Governance structure — ownership, oversight, execution held separately.
const governance = [
  {
    label: 'Ownership',
    body: 'Ownership is held by a family trust.',
  },
  {
    label: 'Oversight',
    body: 'Governance is exercised through a dedicated family council.',
  },
  {
    label: 'Execution',
    body: 'Capital is allocated by a separate management entity.',
  },
];

// Approach — the principles that define how Infinita operates.
const approach = [
  { title: 'Governed, not promotional' },
  { title: 'Long-term oriented' },
  { title: 'Multi-asset class' },
  { title: 'Structured for durability' },
];
---

<Layout title="Infinita Holdings LLC">
  <!-- Hero -->
  <section class="hero section--dark">
    <div class="container hero__inner">
      <div class="hero__lockup">
        <img
          class="hero__mark"
          src={asset('logo.jpg')}
          alt="Infinita — Sovereign · Disciplined · Enduring"
          width="1536"
          height="1024"
          fetchpriority="high"
        />
        <h1 class="hero__wordmark">Infinita</h1>
      </div>
      <p class="lede hero__lede">
        A privately held capital platform governed for long-term continuity
        and disciplined allocation.
      </p>
    </div>
  </section>

  <!-- Purpose -->
  <section class="section" id="purpose">
    <div class="container purpose">
      <div>
        <p class="eyebrow">Purpose</p>
        <h2>A permanent ownership mindset.</h2>
      </div>
      <div class="purpose__body">
        <p>
          Infinita is a privately held capital platform governed for long-term
          continuity and disciplined allocation.
        </p>
        <p>
          Decisions are made with a long horizon and a permanent ownership
          mindset — not the urgency of an agent, nor the calendar of a fund.
        </p>
      </div>
    </div>
  </section>

  <!-- Governance -->
  <section class="section section--paper-pure" id="governance">
    <div class="container">
      <p class="eyebrow">Governance</p>
      <h2>A defined structure.</h2>
      <p class="lede governance__intro">
        Infinita is governed under a defined structure separating ownership,
        oversight and execution.
      </p>
      <div class="governance">
        {governance.map((g) => (
          <article class="layer">
            <h3>{g.label}</h3>
            <p>{g.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section section--dark" id="approach">
    <div class="container">
      <p class="eyebrow">Approach</p>
      <h2>How we operate.</h2>
      <ul class="approach">
        {approach.map((a) => (
          <li class="approach__item">{a.title}</li>
        ))}
      </ul>
      <p class="approach__note">
        Infinita is not a fund nor a financial product company.
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block: clamp(2rem, 6vw, 4rem); }
  .hero__inner { text-align: center; }

  /* Logo lockup — the white wordmark is centred over the infinity mark,
     matching the original opening page. The image's near-black backdrop
     blends into the dark hero, and the % offset tracks the artwork across
     screen sizes. */
  .hero__lockup {
    position: relative;
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
  }
  .hero__mark {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }
  .hero__wordmark {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    color: #fff;
    font-size: clamp(1.7rem, 6vw, 4.25rem);
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.5);
    /* Phase in on load, like the original opening page. */
    opacity: 0;
    animation: heroWordmarkIn 2.4s ease-in 0.3s forwards;
  }
  @keyframes heroWordmarkIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__wordmark { opacity: 1; animation: none; }
  }
  .hero__lede { margin: clamp(1.5rem, 4vw, 2.5rem) auto 0; }

  /* Purpose */
  .purpose {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    align-items: start;
  }
  .purpose__body p:last-child { margin-bottom: 0; }

  /* Governance */
  .governance__intro { margin-top: 1rem; }
  .governance {
    margin-top: 3rem;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(3, 1fr);
  }
  .layer { border-top: 2px solid var(--gold); padding-top: 1.5rem; }
  .layer h3 { margin-bottom: 0.5rem; }
  .layer p { color: var(--muted); margin: 0; }

  /* Approach */
  .approach {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--line-dark);
  }
  .approach__item {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    color: var(--paper);
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--line-dark);
  }
  .approach__item::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--gold);
    margin-right: 1rem;
    vertical-align: middle;
  }
  .approach__note {
    margin-top: 2.5rem;
    color: var(--muted-dark);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 820px) {
    .purpose { grid-template-columns: 1fr; gap: 1.5rem; }
    .governance { grid-template-columns: 1fr; gap: 2rem; }
    .approach { grid-template-columns: 1fr; }
  }
</style>
