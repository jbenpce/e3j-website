---
import Layout from '../layouts/Layout.astro';

// NOTE: Placeholder copy — to be replaced/sharpened with Infinita's real content.
const pillars = [
  {
    title: 'Investment Stewardship',
    body:
      'A disciplined, long-horizon approach to allocating capital across public and private markets — built to compound quietly through cycles.',
  },
  {
    title: 'Wealth & Estate Planning',
    body:
      'Structures that protect and transfer wealth thoughtfully across generations, coordinated with trusted legal and tax advisors.',
  },
  {
    title: 'Family Governance',
    body:
      'Frameworks that align values, decisions, and education — so the next generation inherits not just assets, but judgment.',
  },
];
---

<Layout title="Infinita — Family Office">
  <!-- Hero -->
  <section class="hero section--dark">
    <div class="container hero__inner">
      <p class="eyebrow">Private Family Office</p>
      <h1>Capital, stewarded<br />across generations.</h1>
      <p class="lede">
        Infinita brings discipline, discretion, and a multi-generational
        perspective to the preservation and growth of family wealth.
      </p>
      <div class="hero__cta">
        <a href="/contact" class="btn btn--light">Start a conversation</a>
        <a href="/about" class="hero__link">Learn about us &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Intro statement -->
  <section class="section">
    <div class="container intro">
      <hr class="rule" />
      <p class="intro__statement">
        We exist to serve a single purpose: to protect and grow the wealth of the
        families we partner with, with the patience and care of an owner — not the
        urgency of an agent.
      </p>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section section--paper-pure">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2>An integrated approach</h2>
      <div class="pillars">
        {pillars.map((p) => (
          <article class="pillar">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section section--dark">
    <div class="container cta">
      <h2>A relationship built to last.</h2>
      <p class="lede">
        We work with a limited number of families. If our philosophy resonates,
        we would welcome a conversation.
      </p>
      <a href="/contact" class="btn btn--light">Get in touch</a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block: clamp(5rem, 13vw, 10rem); }
  .hero h1 { margin-bottom: 1.5rem; }
  .hero__cta {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .hero__link {
    color: var(--bronze);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .hero__link:hover { color: var(--paper); }

  .intro__statement {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    line-height: 1.4;
    color: var(--ink);
    max-width: 26ch;
    margin: 0;
  }

  .section--paper-pure { background: var(--paper-pure); }

  .pillars {
    margin-top: 3rem;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(3, 1fr);
  }
  .pillar { border-top: 2px solid var(--bronze); padding-top: 1.5rem; }
  .pillar h3 { margin-bottom: 0.6rem; }
  .pillar p { color: var(--muted); margin: 0; }

  .cta { text-align: center; }
  .cta .lede { margin-inline: auto; margin-bottom: 2.25rem; }

  @media (max-width: 820px) {
    .pillars { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
