---
import Layout from '../layouts/Layout.astro';
---

<Layout title="E3J">
  <!-- Hero — text wordmark, phased in like the Infinita opening page -->
  <section class="hero section--dark">
    <div class="container hero__inner">
      <h1 class="hero__wordmark">E3J</h1>
      <hr class="rule hero__rule" />
      <p class="tagline">Private · Patient · Enduring</p>
      <p class="lede hero__lede">
        A private holding entity, structured for the long term.
      </p>
    </div>
  </section>

  <!-- Purpose -->
  <section class="section section--paper-pure" id="purpose">
    <div class="container purpose">
      <div>
        <p class="eyebrow">Purpose</p>
        <h2>E3J holds.</h2>
      </div>
      <div class="purpose__body">
        <p>
          E3J is a private holding entity. It exists to own and steward assets
          quietly, with a long horizon and a permanent ownership mindset.
        </p>
        <p>
          E3J offers no products or services and does not solicit business of
          any kind.
        </p>
      </div>
    </div>
  </section>

  <!-- Related — Infinita -->
  <section class="section section--dark" id="related">
    <div class="container related">
      <p class="eyebrow">Related</p>
      <h2>Infinita.</h2>
      <p class="lede related__lede">
        For further information and correspondence, visit Infinita — a
        privately held capital platform.
      </p>
      <a class="btn" href="https://infinita.one" rel="noopener">Visit infinita.one</a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block: clamp(5rem, 13vw, 10rem); }
  .hero__inner { text-align: center; }

  .hero__wordmark {
    margin: 0;
    font-size: clamp(3.5rem, 12vw, 8rem);
    letter-spacing: 0.18em;
    line-height: 1.1;
    /* Deep metallic gold — light catches the top of the letterforms and
       falls into a darker bronze at the baseline. */
    background: linear-gradient(
      175deg,
      #f2d98a 0%,
      #daa520 34%,
      #a87d0d 62%,
      #7d5c06 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 3px 22px rgba(218, 165, 32, 0.22));
    /* Phase in on load, like the Infinita opening page. */
    opacity: 0;
    animation: heroWordmarkIn 2.4s ease-in 0.3s forwards;
  }
  @keyframes heroWordmarkIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__wordmark { opacity: 1; animation: none; }
  }
  .hero__rule {
    margin: clamp(1.5rem, 4vw, 2.25rem) auto 1.5rem;
    width: 4.5rem;
    background: linear-gradient(90deg, transparent, var(--gold-dark) 20%, #f2d98a 50%, var(--gold-dark) 80%, transparent);
  }
  .hero .tagline { color: var(--gold-dark); }
  .hero__lede { margin: clamp(1.5rem, 4vw, 2.5rem) auto 0; }

  /* Purpose */
  .purpose {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    align-items: start;
  }
  .purpose__body p:last-child { margin-bottom: 0; }

  /* Related */
  .related__lede { margin-bottom: 2.5rem; }

  @media (max-width: 820px) {
    .purpose { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
