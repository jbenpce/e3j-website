---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About — E3J"
  description="E3J is a private holding entity. It exists to own and steward assets with a long horizon."
>
  <section class="page-hero section--dark">
    <div class="container">
      <p class="eyebrow">About E3J</p>
      <h1>A holding entity.</h1>
      <p class="lede">
        E3J is a private holding entity, structured for the long term.
      </p>
    </div>
  </section>

  <!-- Purpose -->
  <section class="section section--paper-pure">
    <div class="container story">
      <div>
        <p class="eyebrow">Purpose</p>
        <h2>A permanent owner.</h2>
      </div>
      <div class="story__body">
        <p>
          E3J exists to own and steward assets across cycles and generations.
          Decisions are made with a long horizon and a permanent ownership
          mindset, free from external mandates or calendars.
        </p>
        <p>
          The entity is privately held. It operates quietly, durably, and on
          its own terms.
        </p>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="section">
    <div class="container story">
      <div>
        <p class="eyebrow">Related</p>
        <h2>Infinita.</h2>
      </div>
      <div class="story__body">
        <p>
          For further information and correspondence, visit
          <a href="https://infinita.one" rel="noopener">Infinita</a> — a
          privately held capital platform.
        </p>
      </div>
    </div>
  </section>

  <!-- What E3J is not -->
  <section class="section section--dark">
    <div class="container clarify">
      <hr class="rule" />
      <p class="clarify__statement">
        E3J is not a fund nor a financial product company. Nothing on this
        site is an offer, solicitation, or investment advice.
      </p>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-block: clamp(4.5rem, 11vw, 8rem); }

  .story {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: start;
  }
  .story__body p:last-child { margin-bottom: 0; }

  .clarify__statement {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.45;
    color: var(--paper);
    max-width: 34ch;
    margin: 0;
  }

  @media (max-width: 820px) {
    .story { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
